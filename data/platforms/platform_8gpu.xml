            <prop id="io_bandwidth_Bps" value="300000000000" />
            <prop id="gpu_model" value="V100" />
        </host>
        <host id="GPU4" speed="62000Gf" core="1">
            <prop id="wattage_per_state" value="90.0:300.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="473" />
            <prop id="io_bandwidth_Bps" value="300000000000" />
            <prop id="gpu_model" value="V100" />
        </host>
        <host id="GPU5" speed="40000Gf" core="1">
            <prop id="wattage_per_state" value="30.0:75.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="473" />
            <prop id="io_bandwidth_Bps" value="64000000000" />
            <prop id="gpu_model" value="L4" />
        </host>
        <host id="GPU6" speed="40000Gf" core="1">
            <prop id="wattage_per_state" value="30.0:75.0" />
