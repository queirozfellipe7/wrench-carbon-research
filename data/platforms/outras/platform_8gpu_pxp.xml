<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">
    <zone id="AS0" routing="Dijkstra">

        <!-- ================================================== -->
        <!-- HOSTS: 1 CPU Principal (DGX_System ) + 8 GPUs       -->
        <!-- ================================================== -->

        <!-- Host Principal: Representa o chassi, CPUs AMD EPYC, 1TB RAM, etc. -->
        <host id="DGX_System" speed="34000Gf" core="128">
            <!-- Propriedades de Energia e Carbono -->
            <prop id="wattage_per_state" value="300.0:800.0" />
            <prop id="wattage_off" value="25" />
            <prop id="carbon_intensity" value="473" />
            <prop id="io_bandwidth_Bps" value="25000000000" />
            <!-- Disco de alta velocidade -->
            <disk id="nvme_storage" read_bw="25GBps" write_bw="12GBps">
                <prop id="size" value="15000GiB"/>
                <prop id="mount" value="/"/>
            </disk>
        </host>

   
        <host id="GPU1" speed="67000Gf" core="1">
            <prop id="wattage_per_state" value="50.0:700.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="475" />
            <prop id="io_bandwidth_Bps" value="12000000000" />
        </host>
        <host id="GPU2" speed="67000Gf" core="1">
            <prop id="wattage_per_state" value="50.0:700.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="475" />
            <prop id="io_bandwidth_Bps" value="12000000000" />
        </host>
        <host id="GPU3" speed="67000Gf" core="1">
            <prop id="wattage_per_state" value="50.0:700.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="475" />
            <prop id="io_bandwidth_Bps" value="12000000000" />
        </host>
        <host id="GPU4" speed="67000Gf" core="1">
            <prop id="wattage_per_state" value="50.0:700.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="475" />
            <prop id="io_bandwidth_Bps" value="12000000000" />
        </host>
        <host id="GPU5" speed="19500Gf" core="1">
            <prop id="wattage_per_state" value="50.0:400.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="175" />
            <prop id="io_bandwidth_Bps" value="3000000000" />
        </host>
        <host id="GPU6" speed="19500Gf" core="1">
            <prop id="wattage_per_state" value="50.0:400.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="175" />
            <prop id="io_bandwidth_Bps" value="3000000000" />
        </host>
        <host id="GPU7" speed="19500Gf" core="1">
            <prop id="wattage_per_state" value="50.0:400.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="175" />
            <prop id="io_bandwidth_Bps" value="3000000000" />
        </host>
        <host id="GPU8" speed="19500Gf" core="1">
            <prop id="wattage_per_state" value="50.0:400.0" />
            <prop id="wattage_off" value="0" />
            <prop id="carbon_intensity" value="175" />
            <prop id="io_bandwidth_Bps" value="3000000000" />
        </host>

        <!-- ================================================== -->
        <!-- LINKS E ROTAS                                      -->
        <!-- ================================================== -->

        <!-- ===== TODOS OS LINKS (devem vir antes das rotas) ===== -->
        <link id="storage_link" bandwidth="300GBps" latency="2us"/>
        <link id="link_GPU1_GPU2" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU1_GPU3" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU1_GPU4" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU1_GPU5" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU1_GPU6" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU1_GPU7" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU1_GPU8" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU2_GPU3" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU2_GPU4" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU2_GPU5" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU2_GPU6" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU2_GPU7" bandwidth="25GBps" latency="5us"/>
        <link id="link_GPU2_GPU8" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU3_GPU4" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU3_GPU5" bandwidth="25GBps" latency="5us"/>
        <link id="link_GPU3_GPU6" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU3_GPU7" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU3_GPU8" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU4_GPU5" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU4_GPU6" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU4_GPU7" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU4_GPU8" bandwidth="25GBps" latency="5us"/>
        <link id="link_GPU5_GPU6" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU5_GPU7" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU5_GPU8" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU6_GPU7" bandwidth="100GBps" latency="5us"/>
        <link id="link_GPU6_GPU8" bandwidth="50GBps" latency="5us"/>
        <link id="link_GPU7_GPU8" bandwidth="50GBps" latency="5us"/>

        <!-- ===== ROTAS ===== -->
        <!-- Storage: DGX <-> GPUs -->
        <route src="DGX_System" dst="GPU1"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU2"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU3"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU4"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU5"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU6"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU7"><link_ctn id="storage_link"/></route>
        <route src="DGX_System" dst="GPU8"><link_ctn id="storage_link"/></route>
        <!-- Comunicação P×P entre GPUs -->
        <route src="GPU1" dst="GPU2"><link_ctn id="link_GPU1_GPU2"/></route>
        <route src="GPU1" dst="GPU3"><link_ctn id="link_GPU1_GPU3"/></route>
        <route src="GPU1" dst="GPU4"><link_ctn id="link_GPU1_GPU4"/></route>
        <route src="GPU1" dst="GPU5"><link_ctn id="link_GPU1_GPU5"/></route>
        <route src="GPU1" dst="GPU6"><link_ctn id="link_GPU1_GPU6"/></route>
        <route src="GPU1" dst="GPU7"><link_ctn id="link_GPU1_GPU7"/></route>
        <route src="GPU1" dst="GPU8"><link_ctn id="link_GPU1_GPU8"/></route>
        <route src="GPU2" dst="GPU3"><link_ctn id="link_GPU2_GPU3"/></route>
        <route src="GPU2" dst="GPU4"><link_ctn id="link_GPU2_GPU4"/></route>
        <route src="GPU2" dst="GPU5"><link_ctn id="link_GPU2_GPU5"/></route>
        <route src="GPU2" dst="GPU6"><link_ctn id="link_GPU2_GPU6"/></route>
        <route src="GPU2" dst="GPU7"><link_ctn id="link_GPU2_GPU7"/></route>
        <route src="GPU2" dst="GPU8"><link_ctn id="link_GPU2_GPU8"/></route>
        <route src="GPU3" dst="GPU4"><link_ctn id="link_GPU3_GPU4"/></route>
        <route src="GPU3" dst="GPU5"><link_ctn id="link_GPU3_GPU5"/></route>
        <route src="GPU3" dst="GPU6"><link_ctn id="link_GPU3_GPU6"/></route>
        <route src="GPU3" dst="GPU7"><link_ctn id="link_GPU3_GPU7"/></route>
        <route src="GPU3" dst="GPU8"><link_ctn id="link_GPU3_GPU8"/></route>
        <route src="GPU4" dst="GPU5"><link_ctn id="link_GPU4_GPU5"/></route>
        <route src="GPU4" dst="GPU6"><link_ctn id="link_GPU4_GPU6"/></route>
        <route src="GPU4" dst="GPU7"><link_ctn id="link_GPU4_GPU7"/></route>
        <route src="GPU4" dst="GPU8"><link_ctn id="link_GPU4_GPU8"/></route>
        <route src="GPU5" dst="GPU6"><link_ctn id="link_GPU5_GPU6"/></route>
        <route src="GPU5" dst="GPU7"><link_ctn id="link_GPU5_GPU7"/></route>
        <route src="GPU5" dst="GPU8"><link_ctn id="link_GPU5_GPU8"/></route>
        <route src="GPU6" dst="GPU7"><link_ctn id="link_GPU6_GPU7"/></route>
        <route src="GPU6" dst="GPU8"><link_ctn id="link_GPU6_GPU8"/></route>
        <route src="GPU7" dst="GPU8"><link_ctn id="link_GPU7_GPU8"/></route>

        </zone>
</platform>
